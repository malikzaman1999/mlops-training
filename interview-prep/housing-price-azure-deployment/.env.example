# Azure Configuration
# Copy this file to .env and fill in your values

# Azure Subscription ID
# Find it with: az account show --query id -o tsv
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Resource Group name
AZURE_RESOURCE_GROUP=rg-housing-mlops

# Azure ML Workspace name
AZURE_WORKSPACE_NAME=mlw-housing-prod

# Compute cluster name (optional, for remote training)
AZURE_COMPUTE_NAME=training-cluster
