# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored -- .env.example is committed so the REQUIRED
# variables are documented even though the actual secrets aren't.
#
# Where these values come from:
#   BACKEND_STORE_URI  -- postgresql://<admin>:<password>@<fqdn>:5432/mlflow?sslmode=require
#                          <admin> = postgres_admin_username in terraform/variables.tf
#                          <password> = whatever you set via TF_VAR_postgres_admin_password
#                          <fqdn> = `terraform output postgres_fqdn` in terraform/
#   ARTIFACT_ROOT       -- wasbs://mlflow-artifacts@<storage_account_name>.blob.core.windows.net/
#                          <storage_account_name> = `terraform output storage_account_name`
#   AZURE_STORAGE_CONNECTION_STRING -- from:
#     az storage account keys list --resource-group rg-mlops \
#       --account-name <storage_account_name> --query "[0].value" -o tsv
#     then: DefaultEndpointsProtocol=https;AccountName=<name>;AccountKey=<key>;EndpointSuffix=core.windows.net

BACKEND_STORE_URI=postgresql://mlflowadmin:CHANGE_ME@psql-mlops.postgres.database.azure.com:5432/mlflow?sslmode=require
ARTIFACT_ROOT=wasbs://mlflow-artifacts@CHANGE_ME.blob.core.windows.net/
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=CHANGE_ME;AccountKey=CHANGE_ME;EndpointSuffix=core.windows.net
